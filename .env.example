# once: repair one time; cron: schedule every 3 hours.
JOB_MODE=once

MASTER_DB_HOST=replace-with-master-host
MASTER_DB_PORT=1433
MASTER_DB_NAME=replace-with-master-database
MASTER_DB_USER=replace-with-master-user
MASTER_DB_PASSWORD=replace-with-master-password

# Required only by npm run start:central (MASTER -> CENTRAL).
CENTRAL_DB_HOST=replace-with-central-host
CENTRAL_DB_PORT=1433
CENTRAL_DB_NAME=replace-with-central-database
CENTRAL_DB_USER=replace-with-central-user
CENTRAL_DB_PASSWORD=replace-with-central-password
